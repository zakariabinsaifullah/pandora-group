                    "name": "Medium",
                    "size": "40px",
                    "slug": "pandora-40"
                },
                {
                    "name": "Regular",
                    "size": "clamp(30px, 5vw, 50px)",
                    "slug": "pandora-50"
                },
                {
                    "name": "Large",
                    "size": "clamp(30px, 7vw, 70px)",
