                    "slug": "pandora-light-dark"
                }
            ]
        },
        "spacing": {
            "defaultSpacingSizes": false,
            "spacingSizes": [
                {
                    "name": "Edge Gap",
                    "size": "1rem",
                    "slug": "pandora-edge-gap"
                },
                {
                    "name": "Elements Gap",
                    "size": "1.5rem",
                    "slug": "pandora-elements-gap"
                },
                {
