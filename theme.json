    "styles": {
        "blocks": {
            "core/avatar": {
                "border": {
                    "radius": "100px"
                }
            },
            "core/button": {
                "variations": {
                    "outline": {
                        "border": {
                            "color": "var(--wp--preset--color--pandora-white)",
                            "radius": "100px",
                            "style": "solid",
                            "width": "1px"
                        },
                        "color": {
                            "background": "transparent",
                            "text": "var(--wp--preset--color--pandora-white)"
                        },
                        "css": "background: transparent !important;",
                        "spacing": {
                            "padding": {
                                "bottom": "10px",
                                "left": "24px",
                                "right": "24px",
                                "top": "10px"
                            }
                        }
                    },
                    "fill-white": {
                        "color": {
                            "background": "var(--wp--preset--color--pandora-white)",
                            "text": "var(--wp--preset--color--pandora-primary)"
                        },
                        "css": "background: var(--wp--preset--color--pandora-white) !important;"
                    },
                    "gradient-text": {
                        "color": {
                            "background": "var(--wp--preset--color--pandora-white)",
                            "text": "var(--wp--preset--color--pandora-primary)"
                        },
                        "css": "background: var(--wp--preset--color--pandora-white) !important;"
                    },
                    "link": {
                        "border": {
                            "radius": "0px"
                        },
                        "color": {
                            "background": "transparent",
                            "text": "var(--wp--preset--color--pandora-blue-ribbon)"
                        },
                        "css": "background: transparent !important;",
                        "spacing": {
                            "padding": {
                                "bottom": "0",
                                "left": "0",
                                "right": "0",
                                "top": "0"
                            }
                        },
                        "typography": {
                            "fontFamily": "var(--wp--preset--font-family--dm-sans)",
                            "fontSize": "16px",
                            "lineHeight": "1.5"
                        }
                    }
                }
            },
            "core/buttons": {
                "spacing": {
                    "blockGap": "16px"
                }
            },
            "core/code": {
                "color": {
                    "background": "var(--wp--preset--color--accent-5)",
                    "text": "var(--wp--preset--color--pandora-neutral-darkest)"
                },
                "spacing": {
                    "padding": {
                        "bottom": "var(--wp--preset--spacing--pandora-40)",
                        "left": "var(--wp--preset--spacing--pandora-40)",
                        "right": "var(--wp--preset--spacing--pandora-40)",
                        "top": "var(--wp--preset--spacing--pandora-40)"
                    }
                },
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--dm-sans)",
                    "fontSize": "var(--wp--preset--font-size--pandora-small)",
                    "fontWeight": "300"
                }
            },
            "core/columns": {
                "spacing": {
                    "blockGap": "var(--wp--preset--spacing--pandora-50)"
                }
            },
            "core/comment-author-name": {
                "color": {
                    "text": "var(--wp--preset--color--accent-4)"
                },
                "elements": {
                    "link": {
                        ":hover": {
                            "typography": {
                                "textDecoration": "underline"
                            }
                        },
                        "color": {
                            "text": "var(--wp--preset--color--accent-4)"
                        },
                        "typography": {
                            "textDecoration": "none"
                        }
                    }
                },
                "spacing": {
                    "margin": {
                        "bottom": "0px",
                        "top": "5px"
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--pandora-small)"
                }
            },
            "core/comment-content": {
                "spacing": {
                    "margin": {
                        "bottom": "var(--wp--preset--spacing--pandora-30)",
                        "top": "var(--wp--preset--spacing--pandora-30)"
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--pandora-small)"
                }
            },
            "core/comment-date": {
                "color": {
                    "text": "var(--wp--preset--color--pandora-neutral-darkest)"
                },
                "elements": {
                    "link": {
                        "color": {
                            "text": "var(--wp--preset--color--pandora-neutral-darkest)"
                        }
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--pandora-small)"
                }
            },
            "core/comment-edit-link": {
                "elements": {
                    "link": {
                        "color": {
                            "text": "var(--wp--preset--color--pandora-neutral-darkest)"
                        }
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--pandora-small)"
                }
            },
            "core/comment-reply-link": {
                "elements": {
                    "link": {
                        "color": {
                            "text": "var(--wp--preset--color--pandora-neutral-darkest)"
                        }
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--pandora-small)"
                }
            },
            "core/comments-pagination": {
                "spacing": {
                    "margin": {
                        "bottom": "var(--wp--preset--spacing--pandora-40)",
                        "top": "var(--wp--preset--spacing--pandora-40)"
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--pandora-small)"
                }
            },
            "core/comments-pagination-next": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--pandora-small)"
                }
            },
            "core/comments-pagination-numbers": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--pandora-small)"
                }
            },
            "core/comments-pagination-previous": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--pandora-small)"
                }
            },
            "core/list": {
                "css": "& li{margin-top: 0.5rem;}"
            },
            "core/navigation": {
                "elements": {
                    "link": {
                        ":hover": {
                            "typography": {
                                "textDecoration": "underline"
                            }
                        },
                        "typography": {
                            "textDecoration": "none"
                        }
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--pandora-small)"
                }
            },
            "core/paragraph": {
                "color": {
                    "text": "var(--wp--preset--color--pandora-neutral-dark)"
                },
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--dm-sans)",
                    "fontSize": "var(--wp--preset--font-size--pandora-heading-six)",
                    "lineHeight": "1.5"
                }
